#!/bin/bash
set -euo pipefail

# [[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
# OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
OUTPUT_DIR="$HOME/Screenshots"
MODE="${1:-region}"

if [[ ! -d "$OUTPUT_DIR" ]]; then
  notify-send "Screenshot directory does not exist: $OUTPUT_DIR" -u critical -t 3000
  exit 1
fi

timestamp() {
  date +'%Y-%m-%d_%H-%M-%S'
}

is_black_pixel() {
  local color="$1"
  [[ "$color" == *"0,0,0"* ]] || [[ "$color" == "#000000"* ]]
}

trim_black_border() {
  local file="$1"
  command -v convert >/dev/null 2>&1 || return 0
  command -v identify >/dev/null 2>&1 || return 0
  [[ -f "$file" ]] || return 0

  local w h
  read -r w h < <(identify -format "%w %h" "$file")
  if (( w <= 2 || h <= 2 )); then
    return 0
  fi

  local c1 c2 c3 c4 c5
  c1="$(convert "$file" -format "%[pixel:p{0,0}]" info:)"
  c2="$(convert "$file" -format "%[pixel:p{$((w-1)),0}]" info:)"
  c3="$(convert "$file" -format "%[pixel:p{0,$((h-1))}]" info:)"
  c4="$(convert "$file" -format "%[pixel:p{$((w-1)),$((h-1))}]" info:)"
  c5="$(convert "$file" -format "%[pixel:p{1,1}]" info:)"

  if is_black_pixel "$c1" && is_black_pixel "$c2" && is_black_pixel "$c3" && is_black_pixel "$c4" && ! is_black_pixel "$c5"; then
    convert "$file" -shave 1x1 "$file"
  fi
}

detect_session() {
  local desktop="${XDG_CURRENT_DESKTOP:-}"
  desktop="${desktop,,}"

  if [[ "$desktop" == *i3* ]] || pgrep -x i3 >/dev/null 2>&1; then
    echo "i3"
  elif [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || [[ "$desktop" == *hyprland* ]] || pgrep -x Hyprland >/dev/null 2>&1; then
    echo "hyprland"
  else
    echo "unknown"
  fi
}

take_hyprland_shot() {
  pkill slurp || true
  local output_file="$OUTPUT_DIR/screenshot-$(timestamp).png"
  hyprshot -m "$MODE" --raw |
    satty --filename - \
      --output-filename "$output_file" \
      --early-exit \
      --actions-on-enter save-to-clipboard \
      --save-after-copy \
      --copy-command 'wl-copy'
  trim_black_border "$output_file"
}

take_i3_shot() {
  if ! command -v flameshot >/dev/null 2>&1; then
    notify-send "Flameshot não encontrado" "Instale o flameshot para usar este comando no i3wm." -u critical -t 3000
    exit 1
  fi

  local output_file="$OUTPUT_DIR/screenshot-$(timestamp).png"
  case "$MODE" in
    output)
      flameshot screen --clipboard --path "$output_file"
      trim_black_border "$output_file"
      ;;
    window)
      flameshot gui --clipboard --path "$output_file" --accept-on-select --region window
      trim_black_border "$output_file"
      ;;
    *)
      flameshot gui --clipboard --path "$output_file" --accept-on-select
      trim_black_border "$output_file"
      ;;
  esac
}

session="$(detect_session)"
if [[ "$session" == "i3" ]]; then
  take_i3_shot
else
  take_hyprland_shot
fi
